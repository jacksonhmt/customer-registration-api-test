{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Customer registration - success response",
  "type": "object",
  "properties": {
    "success": {
      "type": "boolean",
      "enum": [true]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "fullName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "phoneNumber": {
          "type": "string",
          "pattern": "^\\d{10,11}$"
        },
        "additionalPhone": {
          "type": "string",
          "pattern": "^\\d{10,11}$"
        },
        "birthDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "gender": {
          "type": "string",
          "enum": ["MALE", "FEMALE", "OTHER", "PREFER_NOT_TO_SAY"]
        },
        "address": {
          "type": "object",
          "properties": {
            "zipCode": {
              "type": "string",
              "pattern": "^\\d{8}$"
            },
            "street": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            "number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "complement": {
              "type": ["string", "null"],
              "maxLength": 100
            },
            "neighborhood": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "state": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          },
          "required": ["zipCode", "street", "number", "neighborhood", "city", "state"],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["id", "fullName", "email", "phoneNumber", "birthDate", "createdAt"],
      "additionalProperties": false
    }
  },
  "required": ["success", "message", "data"],
  "additionalProperties": false
}
